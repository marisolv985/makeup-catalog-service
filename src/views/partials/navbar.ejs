<nav class="navbar">
  <div class="navbar-container">
    <a href="/" class="navbar-brand">
      <i data-lucide="sparkles" class="brand-icon"></i>
      GlowFlow
      <span class="brand-sub">Catalog</span>
    </a>

    <button class="navbar-toggle" onclick="document.querySelector('.navbar-links').classList.toggle('active')">
      <i data-lucide="menu"></i>
    </button>

    <div class="navbar-links">
      <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>"><i data-lucide="layout-dashboard"></i> Dashboard</a>
      <a href="/products" class="<%= currentPath.startsWith('/products') ? 'active' : '' %>"><i data-lucide="package"></i> Productos</a>
      <a href="/inventory" class="<%= currentPath === '/inventory' ? 'active' : '' %>"><i data-lucide="warehouse"></i> Inventario</a>
      <a href="/api-docs" target="_blank"><i data-lucide="file-text"></i> API Docs</a>
      <% if (typeof user !== 'undefined' && user) { %>
        <span class="navbar-user">
          <i data-lucide="user" class="user-icon"></i>
          <%= user.username %>
        </span>
        <a href="/logout" class="navbar-logout"><i data-lucide="log-out"></i> Salir</a>
      <% } else { %>
        <a href="/login" class="<%= currentPath === '/login' ? 'active' : '' %>"><i data-lucide="log-in"></i> Sesión</a>
      <% } %>
    </div>
  </div>
</nav>
