<nav class="navbar">
  <div class="navbar-container">
    <a href="/" class="navbar-brand">
      <i data-lucide="sparkles" class="brand-icon"></i>
      GlowFlow
      <span class="brand-sub">Catalog</span>
    </a>

    <button class="navbar-toggle" onclick="document.querySelector('.navbar-links').classList.toggle('active')">
      <i data-lucide="menu" style="width:20px;height:20px"></i>
    </button>

    <div class="navbar-links">
      <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">
        <i data-lucide="layout-dashboard"></i> Dashboard
      </a>
      <a href="/products" class="<%= currentPath.startsWith('/products') ? 'active' : '' %>">
        <i data-lucide="package"></i> Productos
      </a>
      <% if (typeof user !== 'undefined' && user) { %>
        <a href="/cart" class="<%= currentPath === '/cart' ? 'active' : '' %>">
          <i data-lucide="shopping-cart"></i> Carrito
        </a>
        <a href="/orders" class="<%= currentPath.startsWith('/orders') ? 'active' : '' %>">
          <i data-lucide="receipt"></i> Órdenes
        </a>
      <% } %>
      <% if (typeof user !== 'undefined' && user && user.rol === 'ADMIN') { %>
        <a href="/inventory" class="<%= currentPath === '/inventory' ? 'active' : '' %>">
          <i data-lucide="warehouse"></i> Inventario
        </a>
        <a href="/admin/users" class="<%= currentPath === '/admin/users' ? 'active' : '' %>">
          <i data-lucide="users"></i> Usuarios
        </a>
      <% } %>

      <button class="btn-icon" id="darkToggle" title="Cambiar tema" onclick="document.body.classList.toggle('dark');localStorage.setItem('gf_darkMode',document.body.classList.contains('dark'))">
        <i data-lucide="moon" id="darkIcon"></i>
      </button>

      <% if (typeof user !== 'undefined' && user) { %>
        <span class="navbar-user">
          <i data-lucide="circle-user"></i>
          <%= user.username %>
        </span>
        <a href="/logout" class="navbar-logout" id="logoutLink">
          <i data-lucide="log-out"></i> Salir
        </a>
      <% } else { %>
        <a href="/login" class="btn btn-primary btn-sm" style="margin-left:4px">
          <i data-lucide="log-in"></i> Sesión
        </a>
      <% } %>
    </div>
  </div>
</nav>
