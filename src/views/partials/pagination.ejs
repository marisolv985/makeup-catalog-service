<% if (typeof pagination !== 'undefined' && pagination && pagination.totalPages > 1) { %>
  <div class="pagination">
    <% if (pagination.page > 1) { %>
      <a href="?<%= buildPaginationQuery(pagination.page - 1) %>" class="pagination-btn"><i data-lucide="chevron-left" style="width:16px;height:16px"></i></a>
    <% } %>

    <% for (let i = 1; i <= pagination.totalPages; i++) { %>
      <% if (i === pagination.page) { %>
        <span class="pagination-btn active"><%= i %></span>
      <% } else if (i === 1 || i === pagination.totalPages || (i >= pagination.page - 2 && i <= pagination.page + 2)) { %>
        <a href="?<%= buildPaginationQuery(i) %>" class="pagination-btn"><%= i %></a>
      <% } else if (i === pagination.page - 3 || i === pagination.page + 3) { %>
        <span class="pagination-dots">...</span>
      <% } %>
    <% } %>

    <% if (pagination.page < pagination.totalPages) { %>
      <a href="?<%= buildPaginationQuery(pagination.page + 1) %>" class="pagination-btn"><i data-lucide="chevron-right" style="width:16px;height:16px"></i></a>
    <% } %>
  </div>
<% } %>
