<%- include('../layouts/header') %>

<% const isAdmin = typeof user !== 'undefined' && user && user.rol === 'ADMIN'; %>

<% if (isAdmin) { %>
<section class="dash-hero">
  <div class="dash-hero-text">
    <h1>Bienvenido, <%= user.username %></h1>
    <p>Tu centro de control para el catálogo GlowFlow</p>
  </div>
  <div class="dash-hero-actions">
    <a href="/products" class="btn"><i data-lucide="search" style="width:16px;height:16px"></i> Ver Catálogo</a>
    <a href="/products/new" class="btn btn-primary-hero"><i data-lucide="plus" style="width:16px;height:16px"></i> Nuevo Producto</a>
  </div>
</section>

<section class="stats-grid">
  <div class="stat-card">
    <div class="stat-icon" style="background: var(--primary-light); color: var(--primary);">
      <i data-lucide="package" style="width:24px;height:24px"></i>
    </div>
    <div class="stat-info">
      <span class="stat-number"><%= stats.totalProducts %></span>
      <span class="stat-label">Total Productos</span>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-icon" style="background: #d4edda; color: #28a745;">
      <i data-lucide="check-circle" style="width:24px;height:24px"></i>
    </div>
    <div class="stat-info">
      <span class="stat-number"><%= stats.availableProducts %></span>
      <span class="stat-label">Disponibles</span>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-icon" style="background: #fff3cd; color: #e6a817;">
      <i data-lucide="alert-triangle" style="width:24px;height:24px"></i>
    </div>
    <div class="stat-info">
      <span class="stat-number"><%= stats.outOfStockProducts %></span>
      <span class="stat-label">Agotados</span>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-icon" style="background: #f8d7da; color: #dc3545;">
      <i data-lucide="x-circle" style="width:24px;height:24px"></i>
    </div>
    <div class="stat-info">
      <span class="stat-number"><%= stats.inactiveProducts %></span>
      <span class="stat-label">Inactivos</span>
    </div>
  </div>
</section>

<section class="dashboard-section">
  <div class="section-header">
    <h2><i data-lucide="zap" style="width:18px;height:18px;vertical-align:middle"></i> Acciones Rápidas</h2>
  </div>
  <div class="actions-grid">
    <a href="/products/new" class="action-card">
      <div class="action-icon-wrap" style="background: var(--primary-light); color: var(--primary);">
        <i data-lucide="plus"></i>
      </div>
      <span class="action-title">Nuevo Producto</span>
      <span class="action-desc">Agregar un producto al catálogo</span>
    </a>
    <a href="/products" class="action-card">
      <div class="action-icon-wrap" style="background: #e8f4fd; color: #0d6efd;">
        <i data-lucide="eye"></i>
      </div>
      <span class="action-title">Ver Catálogo</span>
      <span class="action-desc">Explorar todos los productos</span>
    </a>
    <a href="/inventory" class="action-card">
      <div class="action-icon-wrap" style="background: #d1ecf1; color: #0c8599;">
        <i data-lucide="bar-chart-3"></i>
      </div>
      <span class="action-title">Inventario</span>
      <span class="action-desc">Consultar y administrar stock</span>
    </a>
    <a href="/admin/users" class="action-card">
      <div class="action-icon-wrap" style="background: #e8daef; color: #7d3c98;">
        <i data-lucide="users"></i>
      </div>
      <span class="action-title">Usuarios</span>
      <span class="action-desc">Gestionar cuentas y roles</span>
    </a>
  </div>
</section>

<section class="dashboard-section">
  <div class="section-header">
    <h2><i data-lucide="layout-grid" style="width:18px;height:18px;vertical-align:middle"></i> Categorías</h2>
    <a href="/products" class="section-link">Ver todas →</a>
  </div>
  <div class="category-grid">
    <% var catIcons = { 'Labios': 'heart', 'Rostro': 'sparkles', 'Ojos': 'eye', 'Brochas': 'pen-tool', 'Skincare': 'droplets', 'Accesorios': 'gem' }; %>
    <% categories.forEach(function(cat) { %>
      <a href="/products?categoria=<%= cat._id %>" class="category-card">
        <span class="category-icon"><i data-lucide="<%= catIcons[cat._id] || 'box' %>" style="width:28px;height:28px"></i></span>
        <span class="category-name"><%= cat._id %></span>
        <span class="category-count"><%= cat.count %> producto<%= cat.count !== 1 ? 's' : '' %></span>
      </a>
    <% }); %>
  </div>
</section>

<% } else { %>

<section class="dash-hero">
  <div class="dash-hero-text">
    <h1>Bienvenido a GlowFlow</h1>
    <p>Explora nuestro catálogo de productos de maquillaje y belleza</p>
  </div>
  <div class="dash-hero-actions">
    <a href="/products" class="btn btn-primary-hero"><i data-lucide="search" style="width:16px;height:16px"></i> Explorar Catálogo</a>
  </div>
</section>

<section class="dashboard-section">
  <div class="section-header">
    <h2><i data-lucide="layout-grid" style="width:18px;height:18px;vertical-align:middle"></i> Categorías</h2>
    <a href="/products" class="section-link">Ver todas →</a>
  </div>
  <div class="category-grid">
    <% var catIcons = { 'Labios': 'heart', 'Rostro': 'sparkles', 'Ojos': 'eye', 'Brochas': 'pen-tool', 'Skincare': 'droplets', 'Accesorios': 'gem' }; %>
    <% categories.forEach(function(cat) { %>
      <a href="/products?categoria=<%= cat._id %>" class="category-card">
        <span class="category-icon"><i data-lucide="<%= catIcons[cat._id] || 'box' %>" style="width:28px;height:28px"></i></span>
        <span class="category-name"><%= cat._id %></span>
        <span class="category-count"><%= cat.count %> producto<%= cat.count !== 1 ? 's' : '' %></span>
      </a>
    <% }); %>
  </div>
</section>

<section class="dashboard-section">
  <div class="section-header">
    <h2><i data-lucide="zap" style="width:18px;height:18px;vertical-align:middle"></i> Acciones Rápidas</h2>
  </div>
  <div class="actions-grid">
    <a href="/products" class="action-card">
      <div class="action-icon-wrap" style="background: #e8f4fd; color: #0d6efd;">
        <i data-lucide="eye"></i>
      </div>
      <span class="action-title">Ver Catálogo</span>
      <span class="action-desc">Explorar todos los productos</span>
    </a>
    <a href="/orders" class="action-card">
      <div class="action-icon-wrap" style="background: var(--primary-light); color: var(--primary);">
        <i data-lucide="shopping-bag"></i>
      </div>
      <span class="action-title">Mis Órdenes</span>
      <span class="action-desc">Revisa el historial de compras</span>
    </a>
    <a href="/cart" class="action-card">
      <div class="action-icon-wrap" style="background: #d4edda; color: #28a745;">
        <i data-lucide="shopping-cart"></i>
      </div>
      <span class="action-title">Mi Carrito</span>
      <span class="action-desc">Ver productos en tu carrito</span>
    </a>
  </div>
</section>

<% } %>

<%- include('../layouts/footer') %>
