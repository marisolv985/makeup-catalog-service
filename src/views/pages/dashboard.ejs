  </div>
</section>

<section class="newsletter" data-aos="fade-up">
  <div class="newsletter-inner">
    <div class="newsletter-text">
      <h2>Únete a GlowFlow</h2>
      <p>Recibe ofertas exclusivas, lanzamientos y tips de belleza directamente en tu correo.</p>
    </div>
    <form class="newsletter-form" onsubmit="event.preventDefault();this.querySelector('.newsletter-msg').textContent='¡Gracias por suscribirte!';this.reset();">
      <div class="newsletter-input-wrap">
        <i data-lucide="mail" style="width:18px;height:18px;color:var(--gray-400)"></i>
        <input type="email" placeholder="Tu correo electrónico" required>
      </div>
      <button type="submit" class="btn btn-primary">Suscribirme</button>
    </form>
    <span class="newsletter-msg"></span>
  </div>
</section>

