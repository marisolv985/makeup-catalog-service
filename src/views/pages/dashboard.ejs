<%- include('../layouts/header') %>

<% const isAdmin = typeof user !== 'undefined' && user && user.rol === 'ADMIN'; %>

<section class="hero" style="background-image:url('/img/hero-bg.jpg')">
  <div class="hero-overlay"></div>
  <div class="hero-content" data-aos="fade-right" data-aos-duration="800">
    <span class="hero-tag"><i data-lucide="sparkles"></i> GlowFlow Beauty</span>
    <h1>Tu universo de <span class="hero-highlight">belleza</span> comienza aquí</h1>
    <p class="hero-subtitle">Descubre miles de productos de maquillaje, skincare y cuidado personal organizados por categorías y marcas.</p>
    <div class="hero-actions">
      <a href="/products" class="hero-btn hero-btn-primary"><i data-lucide="shopping-bag"></i> Explorar Catálogo</a>
    </div>
  </div>
</section>

<section class="trust-bar" data-aos="fade-up" data-aos-delay="100">
  <div class="trust-item">
    <div class="trust-icon"><i data-lucide="truck"></i></div>
    <div><strong>Envío Gratis</strong><span>En compras +$50</span></div>
  </div>
  <div class="trust-divider"></div>
  <div class="trust-item">
    <div class="trust-icon"><i data-lucide="shield-check"></i></div>
    <div><strong>Pago Seguro</strong><span>100% protegido</span></div>
  </div>
  <div class="trust-divider"></div>
  <div class="trust-item">
    <div class="trust-icon"><i data-lucide="rotate-ccw"></i></div>
    <div><strong>Devolución Fácil</strong><span>30 días de garantía</span></div>
  </div>
  <div class="trust-divider"></div>
  <div class="trust-item">
    <div class="trust-icon"><i data-lucide="headphones"></i></div>
    <div><strong>Soporte 24/7</strong><span>Estamos para ti</span></div>
  </div>
</section>

<section class="dashboard-section" data-aos="fade-up">
  <div class="section-header">
    <div class="section-header-left">
      <h2>Productos Destacados</h2>
      <p>Lo más reciente de nuestro catálogo</p>
    </div>
    <a href="/products" class="section-link">Ver todos <i data-lucide="arrow-right" style="width:14px;height:14px"></i></a>
  </div>
  <div class="featured-grid">
    <% featured.forEach(function(p) { %>
      <a href="/products/<%= p._id %>" class="product-card" data-aos="fade-up" data-aos-delay="<%= featured.indexOf(p) * 50 %>">
        <div class="product-image-wrap">
          <% if (p.imagenes && p.imagenes.length > 0) { %>
            <img src="<%= p.imagenes[0] %>" alt="<%= p.titulo %>" loading="lazy">
          <% } else { %>
            <div class="product-placeholder"><i data-lucide="image" style="width:32px;height:32px;color:var(--gray-300)"></i></div>
          <% } %>
          <% if (p.marca) { %><span class="product-badge"><%= p.marca %></span><% } %>
        </div>
        <div class="product-info">
          <span class="product-category"><%= p.categoria %></span>
          <h3 class="product-name"><%= p.titulo %></h3>
          <div class="product-price">$<%= Number(p.precio).toLocaleString('es-MX') %></div>
        </div>
      </a>
    <% }); %>
  </div>
</section>

<section class="how-it-works" data-aos="fade-up">
  <div class="section-header section-header-center">
    <h2>¿Cómo Funciona?</h2>
    <p>Comprar en GlowFlow es fácil y seguro</p>
  </div>
  <div class="steps-grid">
    <div class="step-card" data-aos="fade-up" data-aos-delay="0">
      <div class="step-number">1</div>
      <div class="step-icon" style="background:linear-gradient(135deg,#FDF2F8,#FCE7F3);color:#EC4899">
        <i data-lucide="search"></i>
      </div>
      <h3>Explora</h3>
      <p>Navega por categorías, filtra por marca o busca tus productos favoritos</p>
    </div>
    <div class="step-connector"><i data-lucide="chevron-right"></i></div>
    <div class="step-card" data-aos="fade-up" data-aos-delay="100">
      <div class="step-number">2</div>
      <div class="step-icon" style="background:linear-gradient(135deg,#EFF6FF,#DBEAFE);color:#3B82F6">
        <i data-lucide="shopping-cart"></i>
      </div>
      <h3>Agrega al Carrito</h3>
      <p>Selecciona la cantidad y agrega los productos que deseas comprar</p>
    </div>
    <div class="step-connector"><i data-lucide="chevron-right"></i></div>
    <div class="step-card" data-aos="fade-up" data-aos-delay="200">
      <div class="step-number">3</div>
      <div class="step-icon" style="background:linear-gradient(135deg,#F0FDF4,#DCFCE7);color:#22C55E">
        <i data-lucide="credit-card"></i>
      </div>
      <h3>Recibe en Casa</h3>
      <p>Confirma tu pedido y recibe tus productos de forma segura</p>
    </div>
  </div>
</section>

<section class="dashboard-section" data-aos="fade-up">
  <div class="section-header">
    <div class="section-header-left">
      <h2>Explora por Categoría</h2>
      <p>Encuentra rápidamente tus productos favoritos</p>
    </div>
    <a href="/products" class="section-link">Ver todos <i data-lucide="arrow-right" style="width:14px;height:14px"></i></a>
  </div>
  <% var catStyles = {
    'Labios':     { icon: 'heart',      bg: '#FDF2F8', color: '#EC4899' },
    'Rostro':     { icon: 'sparkles',   bg: '#FFFBEB', color: '#D97706' },
    'Ojos':       { icon: 'eye',        bg: '#EFF6FF', color: '#3B82F6' },
    'Brochas':    { icon: 'pen-tool',   bg: '#F0FDF4', color: '#22C55E' },
    'Skincare':   { icon: 'droplets',   bg: '#EDE9FE', color: '#7C3AED' },
    'Accesorios': { icon: 'gem',        bg: '#FDF2F8', color: '#A855F7' }
  }; %>
  <div class="category-grid">
    <% categories.forEach(function(cat) { %>
      <% var cs = catStyles[cat._id] || { icon: 'box', bg: '#F3F4F6', color: '#6B7280' }; %>
      <a href="/products?categoria=<%= cat._id %>" class="category-card" data-aos="fade-up" data-aos-delay="<%= categories.indexOf(cat) * 50 %>">
        <div class="category-icon-circle" style="background:<%= cs.bg %>;color:<%= cs.color %>">
          <i data-lucide="<%= cs.icon %>"></i>
        </div>
        <span class="category-name"><%= cat._id %></span>
        <span class="category-count"><%= cat.count %> producto<%= cat.count !== 1 ? 's' : '' %></span>
        <i data-lucide="arrow-right" class="category-arrow"></i>
      </a>
    <% }); %>
  </div>
</section>

<% if (isAdmin) { %>

<section class="dashboard-section" data-aos="fade-up">
  <div class="section-header">
    <div class="section-header-left">
      <h2>Panel de Administración</h2>
      <p>Vista general del catálogo de productos</p>
    </div>
  </div>
  <div class="admin-panel-grid">
    <div class="admin-stat-row">
      <div class="admin-stat-card">
        <div class="admin-stat-number"><%= stats.totalProducts %></div>
        <div class="admin-stat-label">Total Productos</div>
        <div class="admin-stat-bar" style="width:100%;background:var(--primary)"></div>
      </div>
      <div class="admin-stat-card">
        <div class="admin-stat-number" style="color:var(--success)"><%= stats.availableProducts %></div>
        <div class="admin-stat-label">Disponibles</div>
        <div class="admin-stat-bar" style="width:<%= stats.totalProducts > 0 ? (stats.availableProducts/stats.totalProducts*100) : 0 %>%;background:var(--success)"></div>
      </div>
      <div class="admin-stat-card">
        <div class="admin-stat-number" style="color:var(--warning)"><%= stats.outOfStockProducts %></div>
        <div class="admin-stat-label">Agotados</div>
        <div class="admin-stat-bar" style="width:<%= stats.totalProducts > 0 ? (stats.outOfStockProducts/stats.totalProducts*100) : 0 %>%;background:var(--warning)"></div>
      </div>
      <div class="admin-stat-card">
        <div class="admin-stat-number" style="color:var(--danger)"><%= stats.inactiveProducts %></div>
        <div class="admin-stat-label">Inactivos</div>
        <div class="admin-stat-bar" style="width:<%= stats.totalProducts > 0 ? (stats.inactiveProducts/stats.totalProducts*100) : 0 %>%;background:var(--danger)"></div>
      </div>
    </div>
  </div>
</section>

<section class="dashboard-section" data-aos="fade-up">
  <div class="section-header">
    <div class="section-header-left">
      <h2>Gestión Rápida</h2>
      <p>Acciones frecuentes del administrador</p>
    </div>
  </div>
  <div class="actions-grid">
    <a href="/products/new" class="action-card">
      <div class="action-icon-wrap" style="background:linear-gradient(135deg,#FDF2F8,#FCE7F3);color:#EC4899">
        <i data-lucide="plus"></i>
      </div>
      <div class="action-text">
        <span class="action-title">Nuevo Producto</span>
        <span class="action-desc">Agregar un producto al catálogo</span>
      </div>
      <i data-lucide="arrow-right" class="action-arrow"></i>
    </a>
    <a href="/inventory" class="action-card">
      <div class="action-icon-wrap" style="background:linear-gradient(135deg,#EFF6FF,#DBEAFE);color:#3B82F6">
        <i data-lucide="bar-chart-3"></i>
      </div>
      <div class="action-text">
        <span class="action-title">Inventario</span>
        <span class="action-desc">Consultar y administrar stock</span>
      </div>
      <i data-lucide="arrow-right" class="action-arrow"></i>
    </a>
    <a href="/admin/users" class="action-card">
      <div class="action-icon-wrap" style="background:linear-gradient(135deg,#EDE9FE,#DDD6FE);color:#7C3AED">
        <i data-lucide="users"></i>
      </div>
      <div class="action-text">
        <span class="action-title">Usuarios</span>
        <span class="action-desc">Gestionar cuentas y roles</span>
      </div>
      <i data-lucide="arrow-right" class="action-arrow"></i>
    </a>
    <a href="/products" class="action-card">
      <div class="action-icon-wrap" style="background:linear-gradient(135deg,#F0FDF4,#DCFCE7);color:#22C55E">
        <i data-lucide="eye"></i>
      </div>
      <div class="action-text">
        <span class="action-title">Ver Catálogo</span>
        <span class="action-desc">Explorar todos los productos</span>
      </div>
      <i data-lucide="arrow-right" class="action-arrow"></i>
    </a>
  </div>
</section>

<% } else { %>

<section class="dashboard-section" data-aos="fade-up">
  <div class="section-header">
    <div class="section-header-left">
      <h2>Accesos Rápidos</h2>
      <p>Navega por las principales secciones</p>
    </div>
  </div>
  <div class="actions-grid">
    <a href="/products" class="action-card">
      <div class="action-icon-wrap" style="background:linear-gradient(135deg,#EFF6FF,#DBEAFE);color:#3B82F6">
        <i data-lucide="package"></i>
      </div>
      <div class="action-text">
        <span class="action-title">Productos</span>
        <span class="action-desc">Explorar todo el catálogo</span>
      </div>
      <i data-lucide="arrow-right" class="action-arrow"></i>
    </a>
    <a href="/cart" class="action-card">
      <div class="action-icon-wrap" style="background:linear-gradient(135deg,#FDF2F8,#FCE7F3);color:#EC4899">
        <i data-lucide="shopping-cart"></i>
      </div>
      <div class="action-text">
        <span class="action-title">Carrito</span>
        <span class="action-desc">Ver productos en tu carrito</span>
      </div>
      <i data-lucide="arrow-right" class="action-arrow"></i>
    </a>
    <a href="/orders" class="action-card">
      <div class="action-icon-wrap" style="background:linear-gradient(135deg,#F0FDF4,#DCFCE7);color:#22C55E">
        <i data-lucide="receipt"></i>
      </div>
      <div class="action-text">
        <span class="action-title">Órdenes</span>
        <span class="action-desc">Historial de tus pedidos</span>
      </div>
      <i data-lucide="arrow-right" class="action-arrow"></i>
    </a>
  </div>
</section>

<% } %>

