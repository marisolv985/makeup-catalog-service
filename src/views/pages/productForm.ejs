<%- include('../layouts/header') %>
<%- include('../partials/breadcrumb') %>

<section class="page-header">
  <div class="page-header-content">
    <div>
      <a href="/products" class="back-link"><i data-lucide="arrow-left" style="width:16px;height:16px"></i> Volver al catálogo</a>
      <h1><%= isEditing ? 'Editar Producto' : 'Nuevo Producto' %></h1>
    </div>
  </div>
</section>

<form method="POST" action="<%= isEditing ? '/products/' + product._id : '/products' %>" enctype="multipart/form-data" class="product-form" id="productForm">

  <div class="form-grid">
    <div class="form-section">
      <h3><i data-lucide="info" style="width:18px;height:18px"></i> Información Básica</h3>

      <div class="form-group">
        <label for="sku">SKU *</label>
        <input type="text" id="sku" name="sku" value="<%= product.sku || '' %>" required placeholder="Ej: COSM-LIP-RED-001" pattern="[A-Z0-9\\-]+" <%= isEditing ? 'readonly' : '' %>>
        <small>Solo letras mayúsculas, números y guiones</small>
      </div>

      <div class="form-group">
        <label for="titulo">Título *</label>
        <input type="text" id="titulo" name="titulo" value="<%= product.titulo || '' %>" required minlength="3" maxlength="200" placeholder="Nombre del producto">
      </div>

      <div class="form-group">
        <label for="descripcion">Descripción *</label>
        <textarea id="descripcion" name="descripcion" required minlength="20" maxlength="2000" rows="4" placeholder="Descripción detallada del producto (mínimo 20 caracteres)"><%= product.descripcion || '' %></textarea>
      </div>

      <div class="form-group">
        <label for="marca">Marca *</label>
        <input type="text" id="marca" name="marca" value="<%= product.marca || '' %>" required placeholder="Ej: Maybelline">
      </div>
    </div>

    <div class="form-section">
      <h3><i data-lucide="layers" style="width:18px;height:18px"></i> Clasificación</h3>

      <div class="form-group">
        <label for="categoria">Categoría *</label>
        <select id="categoria" name="categoria" required>
          <option value="">Seleccionar...</option>
          <% ['Labios', 'Rostro', 'Ojos', 'Brochas', 'Skincare', 'Accesorios'].forEach(function(cat) { %>
            <option value="<%= cat %>" <%= product.categoria === cat ? 'selected' : '' %>><%= cat %></option>
          <% }); %>
        </select>
      </div>

      <div class="form-group">
        <label for="estado">Estado</label>
        <select id="estado" name="estado">
          <% ['DISPONIBLE', 'AGOTADO', 'INACTIVO'].forEach(function(est) { %>
            <option value="<%= est %>" <%= (product.estado || 'DISPONIBLE') === est ? 'selected' : '' %>><%= est %></option>
          <% }); %>
        </select>
      </div>

      <div class="form-group">
        <label for="tono">Tono</label>
        <input type="text" id="tono" name="tono" value="<%= product.tono || '' %>" placeholder="Ej: Rojo Carmesí">
      </div>

      <div class="form-group">
        <label>Tipo de Piel Recomendado</label>
        <div class="checkbox-group">
          <% ['Seca', 'Grasa', 'Mixta', 'Normal', 'Todos'].forEach(function(tip) { %>
            <label class="checkbox-label">
              <input type="checkbox" name="tipoPielRecomendado" value="<%= tip %>" <%= (product.tipoPielRecomendado || []).includes(tip) ? 'checked' : '' %>>
              <%= tip %>
            </label>
          <% }); %>
        </div>
      </div>
    </div>

    <div class="form-section">
      <h3><i data-lucide="dollar-sign" style="width:18px;height:18px"></i> Precio e Inventario</h3>

      <div class="form-group">
        <label for="precio">Precio *</label>
        <input type="number" id="precio" name="precio" value="<%= product.precio || '' %>" required min="0.01" step="0.01" placeholder="0.00">
      </div>

      <div class="form-group">
        <label for="stockDisponible">Stock Disponible *</label>
        <input type="number" id="stockDisponible" name="stockDisponible" value="<%= product.stockDisponible || 0 %>" required min="0" placeholder="0">
      </div>

      <div class="form-group">
        <label for="peso">Peso</label>
        <input type="text" id="peso" name="peso" value="<%= product.peso || '' %>" placeholder="Ej: 30ml, 15g">
      </div>
    </div>

    <div class="form-section">
      <h3><i data-lucide="image" style="width:18px;height:18px"></i> Imágenes e Ingredientes</h3>

      <div class="form-group">
        <label><i data-lucide="upload" style="width:14px;height:14px"></i> Subir imágenes desde tu computadora</label>
        <input type="file" name="imagenesArchivos" id="imagenesArchivos" multiple accept="image/*" class="file-input">
        <small>Formatos: JPG, PNG, GIF, WebP. Máximo 5MB por archivo. Puedes seleccionar varias.</small>
        <div id="imagePreview" class="image-preview"></div>
      </div>

      <% if (isEditing && product.imagenes && product.imagenes.length > 0) { %>
        <div class="form-group">
          <label>Imágenes actuales</label>
          <div class="current-images">
            <% product.imagenes.forEach(function(img) { %>
              <div class="current-image-item">
                <img src="<%= img %>" alt="Imagen actual">
              </div>
            <% }); %>
          </div>
        </div>
      <% } %>

      <div class="form-group">
        <label for="imagenesUrl">O agregar por URL</label>
        <div id="imagenesContainer">
          <div class="input-with-button">
            <input type="url" name="imagenesUrl" placeholder="https://ejemplo.com/imagen.jpg">
            <button type="button" class="btn btn-sm btn-danger" onclick="this.parentElement.remove()"><i data-lucide="x" style="width:14px;height:14px"></i></button>
          </div>
        </div>
        <button type="button" class="btn btn-sm btn-secondary" onclick="addImageField()"><i data-lucide="plus" style="width:14px;height:14px"></i> Agregar URL</button>
      </div>

      <div class="form-group">
        <label for="ingredientes"><i data-lucide="flask-conical" style="width:14px;height:14px"></i> Ingredientes</label>
        <textarea id="ingredientes" name="ingredientesText" rows="3" placeholder="Un ingrediente por línea"><%= (product.ingredientes || []).join('\n') %></textarea>
        <small>Un ingrediente por línea</small>
      </div>
    </div>
  </div>

  <div class="form-actions">
    <button type="submit" class="btn btn-primary"><i data-lucide="<%= isEditing ? 'save' : 'plus' %>" style="width:16px;height:16px"></i> <%= isEditing ? 'Actualizar Producto' : 'Crear Producto' %></button>
    <a href="/products" class="btn btn-secondary">Cancelar</a>
  </div>
</form>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const fileInput = document.getElementById('imagenesArchivos');
  const preview = document.getElementById('imagePreview');

  if (fileInput) {
    fileInput.addEventListener('change', function() {
      preview.innerHTML = '';
      Array.from(this.files).forEach(function(file) {
        const reader = new FileReader();
        reader.onload = function(e) {
          const div = document.createElement('div');
          div.className = 'preview-item';
          div.innerHTML = '<img src="' + e.target.result + '" alt="Preview">';
          preview.appendChild(div);
        };
        reader.readAsDataURL(file);
      });
    });
  }
});
</script>

<%- include('../layouts/footer') %>
