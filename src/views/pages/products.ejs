<%- include('../layouts/header') %>

<section class="page-header">
  <div class="page-header-content">
    <h1>Catálogo de Productos</h1>
    <a href="/products/new" class="btn btn-primary"><i data-lucide="plus" style="width:16px;height:16px"></i> Nuevo Producto</a>
  </div>
</section>

<div class="filters-bar">
  <form method="GET" action="/products" class="filters-form" id="filtersForm">
    <div class="filters-search-row">
      <div class="search-input-wrap">
        <i data-lucide="search" class="search-icon"></i>
        <input type="text" id="busqueda" name="busqueda" value="<%= filters.busqueda || '' %>" placeholder="Buscar por título, marca o ingrediente..." class="search-input">
      </div>
      <button type="submit" class="btn btn-primary btn-search">Buscar</button>
      <button type="button" class="btn btn-secondary btn-filters" id="filtersToggle">
        <i data-lucide="sliders-horizontal" style="width:16px;height:16px"></i>
        Filtros
        <% const activeCount = ['categoria','estado','tono','tipoPiel','marca','precioMin','precioMax'].filter(f => filters[f]).length; %>
        <% if (activeCount > 0) { %><span class="filter-badge"><%= activeCount %></span><% } %>
      </button>
    </div>

    <div class="filters-advanced" id="filtersPanel">
      <div class="filters-advanced-grid">
        <div class="filter-pill">
          <label for="categoria">Categoría</label>
          <select id="categoria" name="categoria">
            <option value="">Todas</option>
            <% ['Labios', 'Rostro', 'Ojos', 'Brochas', 'Skincare', 'Accesorios'].forEach(function(cat) { %>
              <option value="<%= cat %>" <%= filters.categoria === cat ? 'selected' : '' %>><%= cat %></option>
            <% }); %>
          </select>
        </div>

        <div class="filter-pill">
          <label for="estado">Estado</label>
          <select id="estado" name="estado">
            <option value="">Todos</option>
            <% ['DISPONIBLE', 'AGOTADO', 'INACTIVO'].forEach(function(est) { %>
              <option value="<%= est %>" <%= filters.estado === est ? 'selected' : '' %>><%= est %></option>
            <% }); %>
          </select>
        </div>

        <div class="filter-pill">
          <label for="tipoPiel">Tipo de Piel</label>
          <select id="tipoPiel" name="tipoPiel">
            <option value="">Todos</option>
            <% ['Seca', 'Grasa', 'Mixta', 'Normal', 'Todos'].forEach(function(tip) { %>
              <option value="<%= tip %>" <%= filters.tipoPiel === tip ? 'selected' : '' %>><%= tip %></option>
            <% }); %>
          </select>
        </div>

        <div class="filter-pill">
          <label for="marca">Marca</label>
          <input type="text" id="marca" name="marca" value="<%= filters.marca || '' %>" placeholder="Ej: GlowFlow">
        </div>

        <div class="filter-pill">
          <label for="tono">Tono</label>
          <input type="text" id="tono" name="tono" value="<%= filters.tono || '' %>" placeholder="Ej: Rojo">
        </div>

        <div class="filter-pill filter-pill-range">
          <label>Rango de Precio</label>
          <div class="range-inputs">
            <input type="number" id="precioMin" name="precioMin" value="<%= filters.precioMin || '' %>" placeholder="Mín" min="0" step="0.01">
            <span class="range-sep">–</span>
            <input type="number" id="precioMax" name="precioMax" value="<%= filters.precioMax || '' %>" placeholder="Máx" min="0" step="0.01">
          </div>
        </div>
      </div>

      <div class="filters-advanced-actions">
        <a href="/products" class="btn btn-sm btn-ghost"><i data-lucide="x" style="width:14px;height:14px"></i> Limpiar todo</a>
      </div>
    </div>
  </form>
</div>

<% if (activeCount > 0) { %>
  <div class="active-filters">
    <% if (filters.busqueda) { %><span class="active-filter-tag">"<%= filters.busqueda %>" <a href="/products?<%= ['categoria','estado','tono','tipoPiel','marca','precioMin','precioMax'].filter(f => filters[f]).map(f => f + '=' + encodeURIComponent(filters[f])).join('&') %>"><i data-lucide="x" style="width:12px;height:12px"></i></a></span><% } %>
    <% if (filters.categoria) { %><span class="active-filter-tag"><%= filters.categoria %> <a href="/products?<%= ['busqueda','estado','tono','tipoPiel','marca','precioMin','precioMax'].filter(f => filters[f]).map(f => f + '=' + encodeURIComponent(filters[f])).join('&') %>"><i data-lucide="x" style="width:12px;height:12px"></i></a></span><% } %>
    <% if (filters.estado) { %><span class="active-filter-tag"><%= filters.estado %> <a href="/products?<%= ['busqueda','categoria','tono','tipoPiel','marca','precioMin','precioMax'].filter(f => filters[f]).map(f => f + '=' + encodeURIComponent(filters[f])).join('&') %>"><i data-lucide="x" style="width:12px;height:12px"></i></a></span><% } %>
    <% if (filters.tipoPiel) { %><span class="active-filter-tag"><%= filters.tipoPiel %> <a href="/products?<%= ['busqueda','categoria','estado','tono','marca','precioMin','precioMax'].filter(f => filters[f]).map(f => f + '=' + encodeURIComponent(filters[f])).join('&') %>"><i data-lucide="x" style="width:12px;height:12px"></i></a></span><% } %>
    <% if (filters.marca) { %><span class="active-filter-tag">Marca: <%= filters.marca %> <a href="/products?<%= ['busqueda','categoria','estado','tono','tipoPiel','precioMin','precioMax'].filter(f => filters[f]).map(f => f + '=' + encodeURIComponent(filters[f])).join('&') %>"><i data-lucide="x" style="width:12px;height:12px"></i></a></span><% } %>
    <% if (filters.tono) { %><span class="active-filter-tag">Tono: <%= filters.tono %> <a href="/products?<%= ['busqueda','categoria','estado','tipoPiel','marca','precioMin','precioMax'].filter(f => filters[f]).map(f => f + '=' + encodeURIComponent(filters[f])).join('&') %>"><i data-lucide="x" style="width:12px;height:12px"></i></a></span><% } %>
  </div>
<% } %>

<section class="products-section">
  <%- include('../partials/paginationInfo') %>

  <% if (products && products.length > 0) { %>
    <div class="products-grid">
      <% products.forEach(function(product) { %>
        <div class="product-card">
          <div class="product-image">
            <% if (product.imagenes && product.imagenes.length > 0) { %>
              <img src="<%= product.imagenes[0] %>" alt="<%= product.titulo %>" onerror="this.src='/images/placeholder.svg'">
            <% } else { %>
              <div class="product-image-placeholder">
                <i data-lucide="image" style="width:48px;height:48px;opacity:0.3"></i>
              </div>
            <% } %>
            <span class="product-status status-<%= product.estado.toLowerCase() %>"><%= product.estado %></span>
          </div>

          <div class="product-info">
            <span class="product-category"><%= product.categoria %></span>
            <h3 class="product-title"><%= product.titulo %></h3>
            <p class="product-brand"><%= product.marca %></p>
            <p class="product-sku">SKU: <%= product.sku %></p>

            <div class="product-footer">
              <span class="product-price">$<%= product.precio.toFixed(2) %></span>
              <span class="product-stock <%= product.stockDisponible === 0 ? 'stock-empty' : '' %>">
                Stock: <%= product.stockDisponible %>
              </span>
            </div>
          </div>

          <div class="product-actions">
            <a href="/products/<%= product._id %>" class="btn btn-sm btn-outline"><i data-lucide="eye" style="width:14px;height:14px"></i> Ver</a>
            <a href="/products/<%= product._id %>/edit" class="btn btn-sm btn-secondary"><i data-lucide="pencil" style="width:14px;height:14px"></i> Editar</a>
            <button class="btn btn-sm btn-danger" onclick="confirmDelete('<%= product._id %>', '<%= product.titulo %>')"><i data-lucide="trash-2" style="width:14px;height:14px"></i></button>
          </div>
        </div>
      <% }); %>
    </div>

    <%- include('../partials/pagination') %>
  <% } else { %>
    <div class="empty-state">
      <i data-lucide="package-x" class="empty-icon"></i>
      <h3>No se encontraron productos</h3>
      <p>Intenta ajustar los filtros o agrega un nuevo producto al catálogo.</p>
      <a href="/products/new" class="btn btn-primary"><i data-lucide="plus" style="width:16px;height:16px"></i> Nuevo Producto</a>
    </div>
  <% } %>
</section>

<div id="deleteModal" class="modal" style="display:none;">
  <div class="modal-content">
    <h3>Confirmar Eliminación</h3>
    <p>¿Estás seguro de que deseas eliminar el producto <strong id="deleteProductName"></strong>?</p>
    <p class="text-muted">El producto cambiará su estado a INACTIVO.</p>
    <div class="modal-actions">
      <form id="deleteForm" method="POST" style="display:inline;">
        <input type="hidden" name="_method" value="DELETE">
        <button type="submit" class="btn btn-danger"><i data-lucide="trash-2" style="width:14px;height:14px"></i> Eliminar</button>
      </form>
      <button class="btn btn-secondary" onclick="closeModal()">Cancelar</button>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var toggle = document.getElementById('filtersToggle');
  var panel = document.getElementById('filtersPanel');
  if (toggle && panel) {
    toggle.addEventListener('click', function() {
      panel.classList.toggle('open');
      toggle.classList.toggle('active');
    });
  }
});
</script>

<%- include('../layouts/footer') %>
